# ============================================================
# ZingBee Ultra API — environment variables
# Copy this file to .env and fill in the values.
# ============================================================

# --- AI / LLM ---
XAI_API_KEY=                        # xAI Grok (primary LLM + image generation)
OPENAI_API_KEY=                     # OpenAI fallback (optional)
ANTHROPIC_API_KEY=                  # Anthropic fallback (optional)
GOOGLE_AI_API_KEY=                  # Google Gemini (optional)
GOOGLE_APPLICATION_CREDENTIALS=    # Path to GCP service account JSON (for Vertex AI)
VERTEX_IMAGE_PROJECT=               # GCP project ID for Vertex image generation

# --- vLLM on DGX Spark (optional — falls back to frontier APIs if unset) ---
LOCAL_MODEL_ENABLED=false
VLLM_TEXT_GEN_URL=                  # http://<host>:8001/v1  — generation model endpoint
VLLM_TEXT_GEN_MODEL=                # e.g. nvidia/Qwen3-32B-FP4
VLLM_TEXT_EVAL_URL=                 # http://<host>:8002/v1  — evaluation model endpoint
VLLM_TEXT_EVAL_MODEL=               # e.g. nvidia/Qwen3-14B-FP8
VLLM_VISION_URL=                    # http://<host>:8003/v1  — vision/cross-family judge
VLLM_VISION_MODEL=                  # e.g. google/gemma-4-it
VLLM_API_KEY=                       # API key passed to vLLM --api-key (H-16)
VLLM_FALLBACK=true                  # fall back to frontier APIs when vLLM unavailable
LOCAL_GEMMA_URL=                    # Ollama-compatible endpoint for local Gemma (optional)

# --- Database ---
DB_PASSWORD=                        # PostgreSQL password for the zingbee-ultra DB

# --- LiveKit (voice) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Security ---
TURNSTILE_SECRET_KEY=               # Cloudflare Turnstile (CAPTCHA)

# --- ADO #26 engagement-quality flags (canary; OFF in prod) ---
# Gate state-machine behavior changes so code can ship with them OFF and be
# enabled later without a redeploy. Read lazily per turn (see _flag()).
TEACH_SIGNAL_FIX=false              # correct answers during TEACH advance the scaffold + camp-out diagnostic
TRY_HINT=false                      # on-demand hint chip during TRY (capped, non-advancing)
ENGAGEMENT_DETERMINISTIC_CHIPS=false # rotate engagement chips deterministically (no-repeat)

# --- State-machine contract guardrail (ADO-87) ---
# Controls the session-start check that the engine matches api/state_machine/zsm-v006.json.
#   true (default) — contract DRIFT refuses to start the session; a missing/unreadable
#                    contract file is warn-only (won't take down tutoring).
#   strict         — both drift AND a missing/unreadable file are fatal.
#   false/off/no/0 — disable the guardrail entirely (kill-switch for incidents).
SM_CONTRACT_VALIDATION=true
